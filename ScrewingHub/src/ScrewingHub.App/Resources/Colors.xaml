<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== COLOR PALETTE ===== -->
    <!-- Dark theme inspired by industrial HMI panels -->
    <Color x:Key="BgPrimary">#1A1D23</Color>
    <Color x:Key="BgSecondary">#22262E</Color>
    <Color x:Key="BgCard">#2A2E38</Color>
    <Color x:Key="BgCardHover">#323742</Color>
    <Color x:Key="BorderDefault">#3A3F4B</Color>
    <Color x:Key="BorderLight">#4A5060</Color>

    <Color x:Key="TextPrimary">#F0F2F5</Color>
    <Color x:Key="TextSecondary">#9CA3AF</Color>
    <Color x:Key="TextMuted">#6B7280</Color>

    <Color x:Key="AccentBlue">#3B82F6</Color>
    <Color x:Key="AccentBlueDark">#2563EB</Color>
    <Color x:Key="SuccessGreen">#22C55E</Color>
    <Color x:Key="SuccessGreenDark">#16A34A</Color>
    <Color x:Key="DangerRed">#EF4444</Color>
    <Color x:Key="DangerRedDark">#DC2626</Color>
    <Color x:Key="WarningAmber">#F59E0B</Color>
    <Color x:Key="InfoCyan">#06B6D4</Color>

    <!-- ===== BRUSHES ===== -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimary}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefault}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}"/>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}"/>
    <SolidColorBrush x:Key="InfoCyanBrush" Color="{StaticResource InfoCyan}"/>

    <SolidColorBrush x:Key="OkGradientStart" Color="#22C55E"/>
    <SolidColorBrush x:Key="OkGradientEnd" Color="#16A34A"/>
    <SolidColorBrush x:Key="NgGradientStart" Color="#EF4444"/>
    <SolidColorBrush x:Key="NgGradientEnd" Color="#DC2626"/>

</ResourceDictionary>
