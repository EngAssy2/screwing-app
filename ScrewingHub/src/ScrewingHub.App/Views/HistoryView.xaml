<UserControl x:Class="ScrewingHub.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ScrewingHub.App.Converters"
             Background="{StaticResource BgPrimaryBrush}">

    <UserControl.Resources>
        <converters:JudgmentToColorConverter x:Key="JudgColorConv"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="📊 Data Log History" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

        <!-- Filters -->
        <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Date" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Judgment" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding JudgmentFilters}" SelectedItem="{Binding FilterJudgment}"
                              Style="{StaticResource ModernComboBox}" Width="100"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Bottom">
                    <Button Content="🔄 Load" Command="{Binding LoadRecordsCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="16,6"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Bottom">
                    <Button Content="📂 Open CSV" Command="{Binding OpenCsvFileCommand}"
                            Style="{StaticResource IconButton}" Padding="12,6"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <Button Content="📁 Open Folder" Command="{Binding OpenLogFolderCommand}"
                            Style="{StaticResource IconButton}" Padding="12,6"/>
                </StackPanel>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" Margin="40,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Total: " Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRecords}" Style="{StaticResource ValueText}" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="OK: " Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OkRecords}" Style="{StaticResource ValueText}" FontSize="14" Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="NG: " Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NgRecords}" Style="{StaticResource ValueText}" FontSize="14" Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Records}" Style="{StaticResource ModernDataGrid}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RecordNumber}" Width="45"/>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="90"/>
                <DataGridTextColumn Header="CH" Binding="{Binding Channel, StringFormat=CH{0}}" Width="50"/>
                <DataGridTextColumn Header="Screw" Binding="{Binding ScrewName}" Width="100"/>
                <DataGridTextColumn Header="Screw#" Binding="{Binding ScrewProgress}" Width="60"/>
                <DataGridTextColumn Header="Value (Raw)" Binding="{Binding RawCurrentValue}" Width="70"/>
                <DataGridTextColumn Header="Torque (kgf·cm)" Binding="{Binding ConvertedTorque, StringFormat=F3}" Width="95"/>
                <DataGridTextColumn Header="Time(ms)" Binding="{Binding ScrewTimeMs}" Width="70"/>
                <DataGridTextColumn Header="UL (kgf·cm)" Binding="{Binding TorqueUpperLimit, StringFormat=F3}" Width="85"/>
                <DataGridTextColumn Header="LL (kgf·cm)" Binding="{Binding TorqueLowerLimit, StringFormat=F3}" Width="85"/>
                <DataGridTemplateColumn Header="Judgment" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Judgment}" FontWeight="Bold"
                                       Foreground="{Binding Judgment, Converter={StaticResource JudgColorConv}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PLC" Binding="{Binding PlcStatus}" Width="55"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="70"/>
                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <Border Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource LabelText}"/>
        </Border>
    </Grid>
</UserControl>
